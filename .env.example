# ========================================================
# English Janala Monorepo Environment Configuration
# ========================================================

# --- Backend Configuration (backend/.env) ---
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Khoj?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000

# --- Frontend Configuration (frontend/.env.local) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
BETTER_AUTH_SECRET=your_32_character_long_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Provider (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
